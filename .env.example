# Pine — copy to .env / set in your host's dashboard. Everything is optional.

# Listen address (most hosts inject PORT for you)
PORT=3000
HOST=0.0.0.0

# Password-protect the whole instance (HTTP Basic auth). Leave PINE_PASS
# empty for an open instance. Strongly recommended if the URL is public.
PINE_USER=pine
PINE_PASS=

# Allow the Reader engine + Wisp to reach private/loopback addresses
# (home-lab / LAN use). This relaxes SSRF protection — never on a public box.
PINE_ALLOW_PRIVATE=0

# Wisp: comma-separated hostnames (and their subdomains) to refuse.
PINE_BLOCK_HOSTS=

# Wisp: custom upstream DNS servers, comma-separated (uses resolve mode).
PINE_DNS_SERVERS=

# Reader engine limits
PINE_FETCH_TIMEOUT=20000
PINE_MAX_HTML=8388608
PINE_MAX_STREAM=67108864

# Requests per minute per IP on /api/fetch (0 = off)
PINE_RATE_LIMIT=0

# silent | error | warn | info | debug
PINE_LOG_LEVEL=info

# Trust X-Forwarded-For for logs/rate-limit keys (behind a proxy/CDN)
PINE_TRUST_PROXY=1
