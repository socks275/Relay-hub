# Copy to .env (or set these in your host's dashboard). All optional.

# ---- basics ----
PORT=3000
HOST=0.0.0.0

# ---- access control ----
# Require HTTP basic auth. Leave RELAY_PASS empty to run open (local use only).
RELAY_USER=relay
RELAY_PASS=

# ---- branding ----
# Shows a GitHub button in the hub that links here.
RELAY_REPO_URL=https://github.com/your-name/relay-hub

# ---- limits ----
# Upstream timeout in milliseconds.
RELAY_TIMEOUT=30000
# Largest document Relay will buffer and rewrite (bytes).
RELAY_MAX_HTML=12582912
# Largest request body forwarded to the origin (bytes).
RELAY_MAX_BODY=16777216
# Cap on a single streamed resource (bytes).
RELAY_MAX_STREAM=536870912
# Requests per minute per IP. 0 disables the limiter.
RELAY_RATE_LIMIT=0

# ---- cache ----
# Response cache TTL, seconds. 0 disables caching.
RELAY_CACHE_TTL=60
# Response cache size cap, bytes.
RELAY_CACHE_MAX=67108864

# ---- behaviour ----
# Default search engine: duckduckgo | bing | brave | wikipedia | mojeek |
# startpage | ecosia | google
RELAY_ENGINE=duckduckgo
# HTML snippet appended to every proxied page.
RELAY_INJECT=
# Trust X-Forwarded-For (set to 0 if Relay is directly exposed).
RELAY_TRUST_PROXY=1

# ---- security ----
# 1 = allow proxying LAN/private addresses. DISABLES the SSRF guard.
# Only enable on an instance that is not reachable from the internet.
RELAY_ALLOW_PRIVATE=0
# 1 = trust only Node's bundled CA store (ignore the OS trust store).
RELAY_STRICT_TLS=0
# 1 = skip upstream certificate verification. TESTING ONLY.
RELAY_INSECURE_TLS=0

# ---- logging ----
# 0 silences request logs (shorthand for RELAY_LOG_LEVEL=silent).
RELAY_LOG=1
# silent | error | warn | info | debug
RELAY_LOG_LEVEL=info
