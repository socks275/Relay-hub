{
  "name": "relay-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Relay Hub — a fast, tabbed web proxy that runs entirely on GitHub Pages.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "proxy",
    "web-proxy",
    "scramjet",
    "wisp",
    "github-pages",
    "unblocker"
  ],
  "comments": {
    "dependencies": "These are build inputs, not runtime deps: GitHub Pages ships static files only, so the build copies the pinned bundles out of node_modules into dist/. Nothing is installed on the deployed site."
  },
  "dependencies": {
    "@mercuryworkshop/epoxy-transport": "3.0.2",
    "@mercuryworkshop/libcurl-transport": "2.0.6",
    "@mercuryworkshop/scramjet": "2.0.67-alpha.1",
    "@mercuryworkshop/scramjet-controller": "0.0.13",
    "@mercuryworkshop/scramjet-utils": "0.0.3"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
