{
  "name": "relay-hub",
  "version": "2.1.0",
  "description": "A self-hosted web proxy with a launcher-style home screen. Rewrites pages server-side so any site works through it.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "RELAY_LOG_LEVEL=debug node --watch server.js",
    "test": "node --test test/unit.test.js test/security.test.js test/integration.test.js",
    "test:unit": "node --test test/unit.test.js",
    "test:security": "node --test test/security.test.js",
    "test:integration": "node --test test/integration.test.js",
    "check": "node --check server.js && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "server.js",
    "src/",
    "public/"
  ],
  "keywords": [
    "proxy",
    "web-proxy",
    "self-hosted",
    "privacy",
    "launcher",
    "start-page",
    "cors-proxy",
    "unblocker"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {}
}
