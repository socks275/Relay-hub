{
  "name": "pine",
  "version": "1.0.0",
  "description": "Pine — a fast, self-hosted web hub with a Scramjet-powered browser proxy. Play, Apps, Chat, AI, Listen, Watch, Browse.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "PINE_LOG_LEVEL=debug node --watch server.js",
    "test": "node --test test/unit.test.js test/integration.test.js test/smoke.test.js",
    "check": "node --check server.js && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "proxy",
    "web-proxy",
    "scramjet",
    "wisp",
    "self-hosted",
    "unblocker"
  ],
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@mercuryworkshop/epoxy-transport": "3.0.2",
    "@mercuryworkshop/libcurl-transport": "2.0.6",
    "@mercuryworkshop/proxy-transports": "1.0.2",
    "@mercuryworkshop/scramjet": "2.0.67-alpha.1",
    "@mercuryworkshop/scramjet-controller": "0.0.13",
    "@mercuryworkshop/scramjet-utils": "0.0.3",
    "@mercuryworkshop/wisp-js": "0.5.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0"
  }
}
